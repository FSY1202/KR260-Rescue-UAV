# Board's existing WLAN IPv4; never a PC public-interface firewall change.
TELEMETRY_BIND=192.0.2.99
# Only accept this sender IPv4. Replace BOTH addresses for your own WLAN.
TELEMETRY_PEER=192.0.2.10
# Optional shared HMAC key file (>=32 bytes); identical file on the sender.
# TELEMETRY_KEY_FILE=/home/xilinx/.config/pynq-telemetry.key
